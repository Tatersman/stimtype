#!/usr/bin/env python3
"""College vocabulary typing practice for Linux. Python 3.8+, no dependencies."""

import argparse
import codecs
import json
import math
import os
from pathlib import Path
import tempfile
import random
import select
import shutil
import sys
import time
import urllib.parse
import urllib.request


WORDS = tuple("""
abstract aesthetic ambiguity analogous analysis anomaly articulate assertion
assumption autonomy coherent cognitive compelling comprehensive conceptual
conclusion consensus consequence constituent context contingency correlation
criterion critique cumulative deduction demographic derivative discourse
empirical encompass epistemology equilibrium ethical evaluate evidence
explicit facilitate feasible framework fundamental hypothesis ideology
implicit implication inference innovation integrate integrity interpret
intrinsic intuitive justification legitimate methodology mitigate nuanced
objective paradigm paradox parameter perception perspective phenomenon
plausible pragmatic precedent precision premise prevalent principle
proportion qualitative quantitative rationale reciprocal reconcile
relevant resilience rhetoric rigorous scrutiny significant simulation
skeptical spectrum speculative substantial synthesis systematic theoretical
trajectory transition transparent underlying validate variable versatile
""".split())
TOPICS = ("philosophy", "psychology", "economics", "science", "literature",
          "sociology", "research", "mathematics")
MODES = {"1": 15, "2": 30, "3": 60, "4": None}

COLOR_ENABLED = True


def color(text, code):
    if (COLOR_ENABLED and sys.stdout.isatty() and "NO_COLOR" not in os.environ
            and os.environ.get("TERM") != "dumb"):
        return "\033[" + code + "m" + text + "\033[0m"
    return text


def display_score(points):
    # Keep stored records in original units so existing bests scale exactly once.
    return "{:.0f}".format(points * 200)


def score_path():
    root = Path(os.environ.get("XDG_DATA_HOME", ""))
    if not root.is_absolute():
        root = Path.home() / ".local" / "share"
    return root / "stimtype" / "best-scores-inverse-time-v1.json"


def load_bests():
    try:
        data = json.loads(score_path().read_text())
        if isinstance(data, dict):
            return {key: float(value) for key, value in data.items()
                    if key in MODES and type(value) in (int, float)
                    and math.isfinite(value) and value >= 0}
    except (OSError, ValueError, OverflowError):
        pass
    return {}


def save_best(bests, mode, points):
    if points <= bests.get(mode, 0):
        return
    bests[mode] = points
    path = score_path()
    temporary = None
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as f:
            temporary = f.name
            json.dump(bests, f)
        os.replace(temporary, path)
    except OSError:
        print("Best score kept for this run; could not save it to disk.")
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def earned_points(score, elapsed):
    """Accuracy is normalized to 0–1; time is measured in seconds."""
    if elapsed <= 0:
        return 0.0
    return (1.0 / 3.0 + (score / 100.0) * 2.0 / 3.0) / elapsed


def load_words(offline=False):
    """Fetch academically themed vocabulary; safely fall back on any failure."""
    if not offline:
        query = urllib.parse.urlencode({
            "rel_trg": random.choice(TOPICS), "max": 100,
        })
        request = urllib.request.Request(
            "https://api.datamuse.com/words?" + query,
            headers={"User-Agent": "stimtype/1.6.0"},
        )
        try:
            with urllib.request.urlopen(request, timeout=3) as response:
                data = json.loads(response.read(131073))
            if isinstance(data, list):
                words = tuple(dict.fromkeys(
                    item["word"] for item in data
                    if isinstance(item, dict) and isinstance(item.get("word"), str)
                    and 7 <= len(item["word"]) <= 14
                    and item["word"].isascii() and item["word"].isalpha()
                    and item["word"].islower()
                ))
                if len(words) >= 10:
                    return words
        except (OSError, ValueError):
            pass
    return WORDS


def shuffled_words(words):
    """Use every word once per shuffle, avoiding repeats at bag boundaries."""
    words = tuple(dict.fromkeys(words))
    previous = None
    while True:
        bag = list(words)
        random.shuffle(bag)
        if len(bag) > 1 and bag[0] == previous:
            bag[0], bag[1] = bag[1], bag[0]
        for word in bag:
            previous = word
            yield word


class TimeUp(Exception):
    pass


def read_answer(deadline=None):
    if deadline is not None:
        remaining = deadline - time.perf_counter()
        if remaining <= 0 or not select.select([sys.stdin], [], [], remaining)[0]:
            raise TimeUp
    answer = sys.stdin.readline()
    if answer == "":
        raise EOFError
    if deadline is not None and time.perf_counter() >= deadline:
        raise TimeUp
    return answer.rstrip("\r\n")


def live_terminal():
    return (sys.stdin.isatty() and sys.stdout.isatty()
            and os.environ.get("TERM") != "dumb")


def word_heading(word, remaining=None):
    if remaining is None:
        return color(word, "1;36")
    text = "{}  {:.1f}s".format(word, max(0, remaining))
    if live_terminal():
        text = text[:max(1, shutil.get_terminal_size().columns - 1)]
    return color(text, "1;31" if remaining <= 5 else "1;36")


def read_live_answer(word, deadline=None):
    """Read Space/Enter submissions, with optional countdown and controlled echo."""
    import termios
    import tty
    fd = sys.stdin.fileno()
    original = termios.tcgetattr(fd)
    typed = ""
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")

    def redraw(remaining):
        # A horizontally scrolling preview keeps the input on one screen row,
        # even for long answers. Escape non-ASCII for predictable cell widths;
        # the actual Unicode text is preserved for accuracy scoring.
        width = max(1, shutil.get_terminal_size().columns - 1)
        visible = typed.encode("ascii", "backslashreplace").decode("ascii")
        available = max(0, width - 2)
        visible = visible[-available:] if available else ""
        prompt = ("> " + visible)[:width]
        if live_terminal():
            print("\r\033[1A\033[2K" + word_heading(word, remaining)
                  + "\n\r\033[2K" + color(prompt, "35"), end="", flush=True)
        else:
            # Plain-terminal fallback without ANSI cursor sequences.
            print("\r" + prompt.ljust(width) + "\r" + prompt, end="", flush=True)

    try:
        tty.setcbreak(fd, termios.TCSANOW)
        while True:
            remaining = None if deadline is None else max(0, deadline - time.perf_counter())
            redraw(remaining)
            if remaining is not None and remaining <= 0:
                raise TimeUp
            timeout = None if remaining is None else min(0.1, remaining)
            if not select.select([fd], [], [], timeout)[0]:
                continue
            raw = os.read(fd, 1)
            if not raw:
                raise EOFError
            if deadline is not None and time.perf_counter() >= deadline:
                redraw(0)
                raise TimeUp
            if raw in (b" ", b"\r", b"\n") or (raw == b"\x04" and typed):
                print()
                return typed
            if raw == b"\x04":
                raise EOFError
            if raw == b"\x03":
                raise KeyboardInterrupt
            if raw in (b"\x7f", b"\x08"):
                typed = typed[:-1]
                decoder.reset()
            elif raw == b"\x15":  # Ctrl+U clears the answer.
                typed = ""
                decoder.reset()
            elif raw == b"\x17":  # Ctrl+W erases the last word.
                typed = typed.rstrip()
                typed = typed[:typed.rfind(" ") + 1]
                decoder.reset()
            elif raw == b"\x1b":
                # Ignore terminal navigation sequences rather than score them.
                escape_wait = 0.02 if deadline is None else min(0.02, max(0, deadline - time.perf_counter()))
                while select.select([fd], [], [], escape_wait)[0]:
                    part = os.read(fd, 1)
                    if not part or part not in (b"[", b"O") and b"@" <= part <= b"~":
                        break
            else:
                text = decoder.decode(raw)
                typed += "".join(char for char in text if char.isprintable())
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original)


def discard_partial_input():
    # Do not leave an unfinished timed answer for the user's shell to execute.
    if sys.stdin.isatty():
        import termios
        termios.tcflush(sys.stdin, termios.TCIFLUSH)


def accuracy(expected, typed):
    """Score final text using normalized Levenshtein edit distance (0–100)."""
    length = max(len(expected), len(typed))
    if length == 0:
        return 100.0

    # Keep the shorter string in the row to bound working memory.
    if len(expected) < len(typed):
        expected, typed = typed, expected
    previous = list(range(len(typed) + 1))
    for i, expected_char in enumerate(expected, 1):
        current = [i]
        for j, typed_char in enumerate(typed, 1):
            current.append(min(
                current[-1] + 1,                  # Insert a character.
                previous[j] + 1,                  # Delete a character.
                previous[j - 1] + (expected_char != typed_char),
            ))
        previous = current
    return 100.0 * (1.0 - previous[-1] / length)


def play(words, duration=None, best=0.0):
    points = 0.0
    rounds = 0
    deadline = None
    exit_requested = False
    try:
        for word in shuffled_words(words):
            remaining = duration
            if deadline is not None:
                remaining = deadline - time.perf_counter()
                if remaining <= 0:
                    raise TimeUp
            print(word_heading(word, remaining))
            print(color("> ", "35"), end="", flush=True)
            started = time.perf_counter()
            if duration is not None and deadline is None:
                deadline = started + duration
            if sys.stdin.isatty():
                typed = read_live_answer(word, deadline)
            else:
                typed = read_answer(deadline)
            elapsed = time.perf_counter() - started
            if deadline is not None and started + elapsed >= deadline:
                raise TimeUp
            if typed.strip() == ":q":
                break
            score = accuracy(word, typed)
            word_points = earned_points(score, elapsed)
            points += word_points
            rounds += 1
            print(color("accuracy {:.1f}% time: {:.2f}s points: {} score {} best: {}".format(
                score, elapsed, display_score(word_points), display_score(points), display_score(max(best, points)),
            ), "32" if score == 100 else "33") + "\n")
    except TimeUp:
        discard_partial_input()
        print(color("\nTime's up!", "1;33"))
    except (KeyboardInterrupt, EOFError):
        print()
        exit_requested = True
    print(color("words: {} score: {} best: {}".format(
        rounds, display_score(points), display_score(max(best, points))), "1;36"))
    return points, exit_requested


def read_menu_key(fd):
    key = os.read(fd, 1)
    if not key or key == b"\x04":
        raise EOFError
    if key == b"\x1b":
        sequence = b""
        # CSI (ESC [ A/B) and application cursor mode (ESC O A/B).
        for _ in range(2):
            if not select.select([fd], [], [], 0.15)[0]:
                return ""
            sequence += os.read(fd, 1)
        return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down"}.get(sequence, "")
    if key in (b"\r", b"\n"):
        return "enter"
    return key.decode("ascii", errors="ignore").lower()


def choose_menu(title, options):
    """Arrow navigation on terminals, simple line input for pipes/dumb terminals."""
    print(color("\n" + title, "1;36"))
    keys = [key for key, _ in options]
    if not (sys.stdin.isatty() and sys.stdout.isatty()) or os.environ.get("TERM") == "dumb":
        for key, label in options:
            print("{}. {}".format(key, label))
        while True:
            choice = input("Select: ").strip().lower()
            if choice == ":q":
                choice = "q"
            if choice in keys:
                return choice
            print("Choose " + ", ".join(keys) + ".")

    import termios
    import tty
    fd = sys.stdin.fileno()
    original = termios.tcgetattr(fd)
    selected = 0
    print("↑/↓ move · Enter select · q quit")
    try:
        tty.setcbreak(fd)
        print("\033[?25l", end="", flush=True)
        redraw = False
        while True:
            if redraw:
                print("\033[{}A".format(len(options)), end="")
            width = max(1, shutil.get_terminal_size().columns - 1)
            for index, (key, label) in enumerate(options):
                line = ("> " if index == selected else "  ") + key + ". " + label
                line = line[:width]
                print("\r\033[2K" + (color(line, "1;36") if index == selected else line))
            sys.stdout.flush()
            redraw = True
            while True:
                key = read_menu_key(fd)
                if key == "enter":
                    return options[selected][0]
                if key == "q":
                    return "q"
                if key in ("up", "down"):
                    selected = (selected + (1 if key == "down" else -1)) % len(options)
                    break
                if key in keys:
                    selected = keys.index(key)
                    break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original)
        print("\033[?25h", end="", flush=True)


def menu(bests=None):
    bests = bests or {}
    options = []
    for key, seconds in MODES.items():
        label = "Free play" if seconds is None else "{}-second test".format(seconds)
        options.append((key, "{}  best: {}".format(label, display_score(bests.get(key, 0)))))
    return choose_menu("stimtype", options + [("q", "Quit")])


def replay_menu():
    return choose_menu("Play again?", [("1", "Same mode"), ("2", "Change mode"), ("q", "Quit")])


def main():
    global COLOR_ENABLED
    parser = argparse.ArgumentParser(
        description="Practice college-level vocabulary with timed tests or free play.",
        epilog="Type the word and press Space or Enter. :q opens replay; Ctrl+C or EOF quits.",
    )
    parser.add_argument("--offline", action="store_true", help="use the built-in vocabulary without fetching online")
    parser.add_argument("--version", action="version", version="stimtype 1.6.0")
    parser.add_argument("--no-color", action="store_true", help="disable terminal colors")
    args = parser.parse_args()
    COLOR_ENABLED = not args.no_color
    bests = load_bests()
    try:
        choice = menu(bests)
        while choice not in ("q", ":q"):
            if not args.offline:
                print("Loading vocabulary...")
            words = load_words(args.offline)
            print("Type each word and press Space or Enter. :q ends the session; Ctrl+C quits.\n")
            points, exit_requested = play(words, MODES[choice], bests.get(choice, 0))
            save_best(bests, choice, points)
            if exit_requested:
                return 0
            action = replay_menu()
            if action in ("q", ":q"):
                return 0
            if action == "2":
                choice = menu(bests)
        return 0
    except (KeyboardInterrupt, EOFError):
        print()
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
